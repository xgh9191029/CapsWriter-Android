<resources>
    <string name="app_name">CapsWriter 语音输入</string>
    <string name="app_subtitle">离线语音识别 · 透明悬浮按钮 · 不改变你的输入法</string>
    <string name="accessibility_service_label">CapsWriter 悬浮语音输入</string>
    <string name="accessibility_service_description">用于检测输入法是否弹出，在输入法按键上方显示透明悬浮按钮，并把识别结果写入当前输入框。不会收集或上传屏幕内容。</string>

    <string name="section_server">1 · 连接 CapsWriter-Offline 服务器</string>
    <string name="server_hint">服务器地址</string>
    <string name="server_example">例如 192.168.1.100:6016，也支持 ws:// 或 wss://</string>
    <string name="server_supporting">默认端口 6016，对应 CapsWriter-Offline v2.x；旧版服务端请改成 6006。</string>
    <string name="save_and_test">保存并测试</string>

    <string name="section_permissions">2 · 权限与服务</string>
    <string name="enable_service">启用悬浮语音</string>
    <string name="enable_service_desc">开启后会常驻一个低优先级通知，并把透明按钮挂到输入法上方。</string>
    <string name="mic_permission">麦克风</string>
    <string name="notification_permission">通知</string>
    <string name="accessibility_permission">无障碍服务</string>
    <string name="grant">去授权</string>
    <string name="open_settings">去开启</string>
    <string name="granted">已授权</string>
    <string name="not_granted">未授权</string>
    <string name="enabled">已开启</string>
    <string name="disabled">未开启</string>
    <string name="battery_optimization">电池优化</string>
    <string name="ignore_battery_optimization">忽略优化</string>
    <string name="battery_optimized">可能被系统限制</string>
    <string name="battery_ignored">已忽略</string>
    <string name="hide_recents">隐藏最近任务</string>
    <string name="hide_recents_desc">开启后按 Home 不会出现在最近任务列表；关闭后可以从最近任务切回。默认开启。</string>

    <string name="section_output">3 · 识别与输出</string>
    <string name="language">识别语言</string>
    <string name="lang_auto">自动</string>
    <string name="lang_chinese">中文</string>
    <string name="lang_english">英文</string>
    <string name="lang_japanese">日文</string>
    <string name="trim_punctuation">去除末尾标点</string>
    <string name="trim_punctuation_desc">对应 config_client.py 的 trash_punc：去掉结果末尾的 ，。,.；微信聊天会强制去掉。</string>
    <string name="punc_threshold">短句去标点阈值</string>
    <string name="punc_threshold_value">%1$d</string>
    <string name="punc_threshold_desc">不超过 N 个语义单位（中文字/英文单词/数字各算 1）时去掉末尾标点，超过则保留；0 表示总是去掉。</string>
    <string name="save_audio">保存录音（WAV）</string>
    <string name="save_audio_desc">保存到应用专属 Music/CapsWriter 目录，不需要存储权限。</string>
    <string name="recording_path">录音目录：%1$s</string>
    <string name="min_record">最短录音</string>
    <string name="min_record_desc">对应 config_client.py 的 threshold；短于这个时长会当作误触取消。</string>
    <string name="min_record_value">%1$.2f 秒</string>
    <string name="section_overlay">4 · 悬浮按钮与位置</string>
    <string name="overlay_size">按钮大小</string>
    <string name="overlay_width">宽度</string>
    <string name="overlay_height">高度</string>
    <string name="input_mode">触发方式</string>
    <string name="mode_hold">按住说话</string>
    <string name="mode_tap">点击开关</string>
    <string name="calibrate">校准位置</string>
    <string name="reset_position">重置所有校准</string>
    <string name="pass_through_short_tap">短按穿透到输入法</string>
    <string name="pass_through_short_tap_desc">按住时正常录音；短按不录音，而是把点击转发给下层输入法的语音键，让输入法自己的短按功能不受透明悬浮窗影响。需要无障碍手势权限，更新后请关闭再开启一次无障碍服务。</string>
    <string name="calibrate_help">点“校准位置”后，应用会在输入法上方显示一个蓝色虚线框。宽高可分别调整；把框拖到输入法语音键的位置再保存。每个输入法、横竖屏会分别记住自己的位置和大小。</string>
    <string name="section_hotwords">6 · 客户端热词</string>
    <string name="hotwords_hint">每行一个词，或“错词=>正确词”</string>
    <string name="hotwords_help">单独一行会作为识别提示发给服务端；含 =&gt; 的规则会在识别结果里做替换；re: 开头表示正则，例如 re:卡普斯[沃我]=>CapsWriter。</string>
    <string name="save_hotwords">保存热词</string>
    <string name="hotwords_empty">还没有热词</string>
    <string name="hotwords_saved">已保存 %1$d 个词、%2$d 条替换规则</string>
    <string name="reset_done">所有输入法的位置和大小已重置</string>

    <string name="section_test">5 · 试一下</string>
    <string name="test_hint">点这里唤起输入法，然后按住透明按钮说话</string>
    <string name="last_result">最近识别</string>
    <string name="no_result">还没有识别结果</string>

    <string name="section_guide">使用步骤</string>
    <string name="guide_text">1. 在电脑上启动 CapsWriter-Offline 服务端，确认手机和电脑在同一局域网。\n2. 填入电脑的局域网 IP 和端口，保存并测试。\n3. 授予麦克风、通知权限，并开启无障碍服务。\n4. 打开“启用悬浮语音”，点“校准位置”把框对齐输入法的语音键。\n5. 在任意应用中唤起输入法，按住透明区域说话，松开后文字会自动写入当前输入框。\n\n本应用默认从最近任务列表隐藏；从通知或桌面图标回到应用。\n首次使用建议先在本页的测试输入框里试。部分输入法/应用不允许无障碍写入时，识别结果会复制到剪贴板。</string>

